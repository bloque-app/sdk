ORIGIN=your-origin-namespace
ORIGIN_KEY=sk_live_or_test_your_origin_key

# Return URL the hosted gates redirect back to after TOS acceptance /
# verification submission. Must already be present in the backend's
# TOS_GATE_RETURN_URL_ALLOWLIST and VERIFICATION_GATE_RETURN_URL_ALLOWLIST
# (payment-rails env config) — otherwise start() fails with
# E_RETURN_URL_NOT_ALLOWED before the check can even get to the assertion
# it's actually testing.
CHECK_RETURN_URL=https://example.com/verification-complete

# Optional overrides
# CHECK_AMOUNT_SRC=100000000
